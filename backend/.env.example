# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+psycopg2://science:CHANGE_ME@localhost:5432/science_study
TEST_DATABASE_URL=postgresql+psycopg2://science:CHANGE_ME@localhost:5432/science_study_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Seed/bootstrap admin account (used by `python -m app.db.seed`)
ADMIN_EMAIL=admin@sciencestudy.app
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# AI provider (optional). Without a key the AI endpoints report "not configured"
# instead of guessing answers.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Firebase / Google sign-in verification (optional)
GOOGLE_CLIENT_ID=

CORS_ORIGINS=*
UPLOAD_DIR=uploads
